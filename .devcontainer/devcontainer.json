{
	"name": "siomporas-arcade",
	// Node-only image: three Vite/TypeScript + three.js games in one npm workspace —
	// no pipeline, no second language toolchain.
	"image": "mcr.microsoft.com/devcontainers/typescript-node:22",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// Share the host's network namespace so the Vite dev server is reachable
	// directly from the host browser. On Docker Desktop (macOS/Windows) this
	// requires "Enable host networking" in Settings > Resources > Network.
	"runArgs": ["--network=host"],
	// Vite dev servers: conduit (5180), Stuntin’ (5181), coast/Turbo Radrun (5182).
	"forwardPorts": [5180, 5181, 5182],
	"initializeCommand": "cmd.exe /c powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; New-Item -ItemType Directory -Force -Path $env:USERPROFILE\\.claude | Out-Null; if (!(Test-Path $env:USERPROFILE\\.claude.json)) { Set-Content -Path $env:USERPROFILE\\.claude.json -Value '{}' }\" || sh -c 'mkdir -p \"$HOME/.claude\" && touch \"$HOME/.claude.json\"'",
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"oxc.oxc-vscode",
				"esbenp.prettier-vscode",
				"slevesque.shader",
				"anthropic.claude-code"
			],
			"settings": {
				"editor.formatOnSave": false,
				"typescript.tsdk": "node_modules/typescript/lib"
			}
		}
	}
}
