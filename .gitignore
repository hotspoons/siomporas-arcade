# Node
node_modules/
dist/
apps/*/dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# Editor/OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store

# Claude Code local state (worktrees, session scratch)
.claude/

# ad-hoc dev probe scripts (throwaway; kept local, never committed)
probes/*
!probes/*.mjs
!probes/*.py
_*.mjs
shots/
.tunnel-url*
apps/*/test/_*.test.ts

ext/*

# arcade: mirrored from each game's public/ by scripts/sync-arcade-assets.mjs
apps/arcade/public/assets/
apps/arcade/public/fonts/

# python bytecode
__pycache__/
*.pyc

# enginesim's wasm is a COMMITTED artefact, not build output to ignore: it is imported at build
# time, so a build with it absent fails. Its provenance is in wasm/BUILD.json and its licence
# beside it.
!packages/enginesim/wasm/

# packages/enginesim/packs — the baked engine library (npm run bake -w @apex/enginesim).
#
# A working artefact, not a source one. The full catalog is twenty engines, 357 loops and about
# 16 MiB of WAV, and nothing in the game needs twenty engines of traffic — the shipped set will be
# a handful of archetypes, baked with `--engine` and committed where it is served from. There is
# no Opus encoder in this container, so a WAV bake of the whole catalog stays local.
packages/enginesim/packs/

probes/.build/
.mcp.json
