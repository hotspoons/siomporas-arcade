# Node
node_modules/
dist/
apps/*/dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# Editor/OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store

# Claude Code local state (worktrees, session scratch)
.claude/

# ad-hoc dev probe scripts (throwaway; kept local, never committed)
probes/*
!probes/*.mjs
!probes/*.py
_*.mjs
shots/
shots/
.tunnel-url*
apps/*/test/_*.test.ts

ext/*

# arcade: mirrored from each game's public/ by scripts/sync-arcade-assets.mjs
apps/arcade/public/assets/
apps/arcade/public/fonts/

# corridor: the geo tool's venv and its downloaded lidar/imagery/OSM cache (rebuildable, GBs)
tools/corridor/.venv/
tools/corridor/data/

# corridor viewer: generated textures (tools/surfaces/gen.py) and generated props (editor
# probes/editor-assets.mjs) are regenerable and ~100 MB; they will live in a bucket, not in git.
# catalog.json and the vendored Draco decoder stay.
apps/corridor/public/surfaces/
apps/corridor/public/assets/*.glb
